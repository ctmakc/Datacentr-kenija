  "about": {
    "title": "About Us",
    "vision": {
      "title": "Our Vision",
      "mission": "To democratize access to AI compute infrastructure across Africa, enabling innovation and economic growth through sustainable, affordable computing power.",
      "whyAfrica": "Why Africa Needs AI Infrastructure",
      "whyAfricaText": "Africa represents the next frontier of digital transformation. With rapidly growing tech ecosystems, increasing connectivity, and a young, dynamic population, the continent is poised for an AI revolution. However, the lack of local compute infrastructure creates a bottleneck for innovation.",
      "energyArbitrage": "The Energy Arbitrage Opportunity",
      "energyArbitrageText": "By generating our own power at $0.04/kWh, we achieve a 60-70% cost advantage over competitors relying on grid power. This fundamental economics enables us to offer compute at globally competitive rates while maintaining strong margins.",
      "longTerm": "Pan-African AI Backbone",
      "longTermText": "Our vision extends beyond Kenya. We aim to build a network of AI compute facilities across Africa, connected by high-speed fiber, creating the continent's first truly distributed AI infrastructure.",
      "sdg": "UN SDG Alignment",
      "sdgText": "Our project directly contributes to UN Sustainable Development Goals: SDG 9 (Industry, Innovation, Infrastructure), SDG 8 (Decent Work and Economic Growth), and SDG 13 (Climate Action) through sustainable compute."
    },
